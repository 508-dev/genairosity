{
  "name": "genairosity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --watch scripts/serve.ts",
    "build": "bun scripts/build.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun scripts/validate.ts",
    "check": "./scripts/check-all.sh",
    "ports": "bun scripts/ports.ts",
    "init:project": "python3 scripts/init-project.py",
    "check:project": "python3 devkit/template/scripts/check-project.py",
    "github:setup": "bun scripts/github-setup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  },
  "trustedDependencies": []
}
